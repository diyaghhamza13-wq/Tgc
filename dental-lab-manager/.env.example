# Supabase project (Project Settings -> API). The anon/publishable key is safe
# to ship in the app; NEVER put the service-role key here.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Optional: override the edge functions base URL (defaults to <SUPABASE_URL>/functions/v1)
# EXPO_PUBLIC_FUNCTIONS_URL=
