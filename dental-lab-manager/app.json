{
  "expo": {
    "name": "Dental Lab Manager",
    "slug": "dental-lab-manager",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.dentallabmanager"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#050B15",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.dentallabmanager"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-sharing",
      "expo-localization",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow access to photos to attach case images and profile pictures."
        }
      ]
    ],
    "scheme": "dentallabmanager",
    "backgroundColor": "#050B15",
    "extra": {
      "supportsRTL": true
    },
    "experiments": {
      "typedRoutes": false
    }
  }
}